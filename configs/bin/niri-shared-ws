#!/usr/bin/env python3
import json
import os
import socket
import sys


def main():
    if len(sys.argv) < 2:
        sys.exit(1)

    sock_path = os.environ.get("NIRI_SOCKET")
    if not sock_path:
        sys.exit(1)

    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(sock_path)
        f = s.makefile("rw")

        def req(payload):
            f.write(json.dumps(payload) + "\n")
            f.flush()
            return json.loads(f.readline())

        if sys.argv[1] == "move":
            ws_name = sys.argv[2]
            req({
                "Action": {
                    "MoveColumnToWorkspace": {
                        "reference": {"Name": ws_name},
                        "focus": True,
                    }
                }
            })
            return

        ws_name = sys.argv[1]
        target_output = sys.argv[2] if len(sys.argv) >= 3 and sys.argv[2] else None

        if not target_output:
            res = req("FocusedOutput")
            target_output = (res.get("Ok", {}).get("FocusedOutput") or {}).get("name")

        ws_res = req("Workspaces")
        workspaces = ws_res.get("Ok", {}).get("Workspaces") or []

        target_ws = next((w for w in workspaces if w.get("name") == ws_name), None)
        if not target_ws:
            req({"Action": {"FocusWorkspace": {"reference": {"Name": ws_name}}}})
            return

        source_output = target_ws.get("output")
        target_was_active_on_source = bool(target_ws.get("is_active"))

        current_active_on_target = next(
            (
                w
                for w in workspaces
                if w.get("output") == target_output and w.get("is_active")
            ),
            None,
        )

        if target_output and source_output and source_output != target_output:
            req({
                "Action": {
                    "MoveWorkspaceToMonitor": {
                        "output": target_output,
                        "reference": {"Id": target_ws["id"]},
                    }
                }
            })

            if (
                target_was_active_on_source
                and current_active_on_target
                and current_active_on_target["id"] != target_ws["id"]
            ):
                req({
                    "Action": {
                        "MoveWorkspaceToMonitor": {
                            "output": source_output,
                            "reference": {"Id": current_active_on_target["id"]},
                        }
                    }
                })
                req({
                    "Action": {
                        "FocusWorkspace": {
                            "reference": {"Id": current_active_on_target["id"]}
                        }
                    }
                })

        req({"Action": {"FocusWorkspace": {"reference": {"Id": target_ws["id"]}}}})


if __name__ == "__main__":
    main()
