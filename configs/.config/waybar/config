      "show-icon": false,
      "tooltip": false
    },
    "upower#headset": {
      "format": "  {percentage}",
      "hide-if-empty": true,
      "native-path": "/org/bluez/hci0/dev_F8_4E_17_BC_B6_66",
      "show-icon": false,
      "tooltip": false
    }
  }
